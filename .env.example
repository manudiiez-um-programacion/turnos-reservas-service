# Plantilla de variables de entorno del servicio de turnos y reservas.
#
#   cp .env.example .env     y completar con los valores reales
#
# .env esta en .gitignore y NUNCA se versiona. Los valores de abajo son
# ejemplos ficticios: ninguno es una credencial real.
#
# Cubre todo lo que el servicio necesita: Docker Compose, la base propia, la
# integracion con la catedra y los secretos de los JWT que emitimos.
#
# Las variables de la seccion "Integracion" y los dos secretos de JWT NO tienen
# default: si falta una, el servicio NO ARRANCA y el error dice cual. Es a
# proposito. Un default inventado para una URL o un JWT no sirve para nada y
# solo esconde el problema hasta la primera llamada real.

# --- Aplicacion ---------------------------------------------------------
# Perfil activo al correr la app FUERA de Docker. Dentro de compose el perfil
# lo fija compose.yaml en 'docker' y esta variable no se usa.
SPRING_PROFILES_ACTIVE=local

# Puerto con el que se accede al servicio desde la maquina. 8081 por defecto:
# el servicio de catalogo usa el 8080 y los dos tienen que poder correr a la
# vez. Dentro del contenedor la app siempre escucha en 8081.
SERVER_PORT=8081

# Swagger UI y /v3/api-docs. Poner en false para apagarlos.
SPRINGDOC_ENABLED=true

# --- Base de datos propia -----------------------------------------------
# PostgreSQL. El enunciado §3 exige un gestor servidor y prohibe H2, SQLite y
# cualquier base embebida como almacenamiento principal.
#
# La solucion completa usa UNA instancia de PostgreSQL con dos bases logicas:
# 'catalogo' y 'turnos_reservas', cada una con su propio usuario y sin
# permisos cruzados. Ver el README.
DB_NAME=turnos_reservas
DB_USERNAME=turnos
DB_PASSWORD=cambiar-en-local

# Puerto con el que Docker Compose publica PostgreSQL en la maquina. 5433 por
# defecto para no chocar con el PostgreSQL del catalogo, que usa el 5432.
# Cambiarlo si el 5433 tambien esta ocupado.
DB_PORT=5433

# DB_URL se usa SOLO al correr la app fuera de Docker (./mvnw spring-boot:run),
# apuntando al PostgreSQL publicado por Compose en localhost. Dentro de compose
# el host es el nombre del servicio y la URL la arma el perfil 'docker': esta
# linea no se toca. Si se deja vacia, el default ya apunta aca.
DB_URL=jdbc:postgresql://localhost:5433/turnos_reservas

# Cuenta de administracion de la instancia de PostgreSQL. La aplicacion NUNCA
# la usa: solo sirve para que el script de init cree el rol del servicio, que
# es un usuario comun sin permisos sobre otras bases. Ver
# docker/postgres/init/02-crear-base-turnos.sh.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar-en-local

# --- Integracion con la catedra -----------------------------------------
# TODO esto lo entrega la catedra y es OBLIGATORIO: sin estos valores el
# servicio no arranca. Los de abajo son ficticios y sirven para levantar el
# entorno local; reemplazarlos por los reales cuando la catedra provisione la
# cuenta.
#
# De donde sale cada uno:
#   - CATEDRA_API_BASE_URL  la informa la catedra por otro canal     (§3)
#   - CATEDRA_JWT           lo emite el registro de la cuenta tecnica
#                           y lo renueva POST /api/authenticate      (§5.1, §5.2)
#   - el resto              viene en el objeto `integration` que
#                           devuelve GET /api/student/integration    (§5.3)
#
# El JWT tecnico tiene vigencia de UN AÑO y es el mismo para los dos backends
# del proyecto. NUNCA se envia a la app KMP ni al servicio de catalogo, y nunca
# se acepta como credencial de entrada. Si se expone, no alcanza con borrarlo de
# un commit: hay que crear otra cuenta tecnica y avisar a la catedra (§5.4).
CATEDRA_API_BASE_URL=https://turnos.catedra.invalido
CATEDRA_JWT=reemplazar-por-el-jwt-tecnico-real
CATEDRA_GROUP_ID=proyecto-nombre-apellido

# Kafka. Los nombres dependen del groupId, asi que se configuran enteros y no
# se arman concatenando en el codigo: si la catedra reprovisiona la cuenta,
# cambia esto y no hay que recompilar.
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=kafka.catedra.invalido:9092
CATEDRA_KAFKA_CONSUMER_GROUP_ID=alumnos-proyecto-nombre-apellido
# Entrada: catedra -> alumno (confirmaciones, rechazos, vencimientos).
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=alumnos.turnos.acciones.proyecto-nombre-apellido
# Salida: alumno -> catedra (el telefono del usuario).
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=catedra.turnos.telefono.proyecto-nombre-apellido

# --- Redis: OPCIONAL para este servicio ---------------------------------
# Este servicio NO necesita Redis y arranca sin nada de esto. El snapshot del
# catalogo que la catedra publica por Redis lo consume el OTRO backend; aca las
# ocupaciones y los holds se piden por REST, y §14.1 es explicito en que los
# holds no tienen acceso contractual por Redis.
#
# Queda configurable por si se usa el namespace privado alumnos:{groupId}:*
# para estado auxiliar propio (§14.6). Dejar vacio si no se usa.
CATEDRA_REDIS_HOST=
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=
CATEDRA_REDIS_PASSWORD=
CATEDRA_REDIS_READ_NAMESPACE=
CATEDRA_REDIS_WRITE_NAMESPACE=

# --- JWT que emite este servicio ----------------------------------------
# Dos secretos OBLIGATORIOS, de 32 caracteres o mas, y que tienen que ser
# DISTINTOS entre si: hay una validacion que rechaza el arranque si se copio el
# mismo valor en los dos.
#
# Que sean distintos no es prolijidad: es lo que hace criptografica la
# separacion entre "un usuario pidiendo algo" y "un backend pidiendo algo". Con
# un secreto compartido, un token de usuario robado se podria presentar como si
# fuera el del servicio.
#
# Generar cada uno por separado:
#
#   openssl rand -base64 48
#
# JWT_USER_SECRET firma el token del usuario final. El servicio de catalogo
# valida ese mismo token, asi que los dos repos comparten ESTE valor.
JWT_USER_SECRET=generar-con-openssl-rand-base64-48
# JWT_INTERNAL_SECRET firma las llamadas de este servicio al de catalogo, con
# autoridad SERVICE_TURNOS. No representa a ningun usuario.
JWT_INTERNAL_SECRET=generar-otro-distinto-con-openssl-rand-base64-48

# Opcionales: tienen default y se pueden dejar como estan.
JWT_ISSUER=turnos-reservas-service
# Formato ISO-8601 de duracion: PT1H = una hora, PT2M = dos minutos.
JWT_USER_EXPIRATION=PT1H
JWT_INTERNAL_EXPIRATION=PT2M
